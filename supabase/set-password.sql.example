-- ============================================
-- CONFIGURAR CONTRASEÑA DE LA APP
-- ============================================
-- 1. Copia este archivo a "set-password.sql"
-- 2. Cambia 'TU_CONTRASEÑA_AQUI' por tu contraseña real
-- 3. Ejecuta este script en Supabase SQL Editor
-- 4. NO subas set-password.sql a GitHub
-- ============================================

INSERT INTO configuracion (clave, valor, descripcion)
VALUES (
  'app_password_hash',
  encode(sha256('TU_CONTRASEÑA_AQUI'::bytea), 'hex'),
  'Hash SHA-256 de la contraseña de acceso a la aplicación'
)
ON CONFLICT (clave) DO UPDATE SET 
  valor = encode(sha256('TU_CONTRASEÑA_AQUI'::bytea), 'hex');

-- Verificar
SELECT clave, descripcion FROM configuracion WHERE clave = 'app_password_hash';
